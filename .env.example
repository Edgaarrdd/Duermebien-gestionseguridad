# Plantilla de Variables de Entorno para el Portal de Seguridad
# Copiar este archivo como .env en el servidor y configurar valores seguros

# Entorno de ejecución: production o development
FLASK_ENV=production

# Llave secreta criptográfica para firma de cookies de sesión (generar con: python3 -c 'import secrets; print(secrets.token_hex(32))')
SECRET_KEY=cambiar-por-una-clave-aleatoria-robusta-en-produccion

# Ruta de la base de datos interna SQLite
DATABASE_PATH=/opt/security-portal/data/portal_security.db

# Puerto de escucha del servicio interno Gunicorn
PORT=8000
